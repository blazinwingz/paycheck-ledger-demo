{
  "name": "paycheck-ledger-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo of a paycheck ledger with invented data: hourly or salaried pay, a next-paycheck forecast, year-end tax outlook, and past years.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "css": "python3 tools/gen-css.py",
    "test": "node tools/render-check.mjs && node tests/run.mjs",
    "test:ui": "python3 tests/browser/demo_test.py",
    "setup": "node -e \"require('fs').copyFileSync('src/seed.example.js','src/seed.js')\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
